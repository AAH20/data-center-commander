# Data Center Commander — Development Server
FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY pyproject-async.toml .
RUN pip install --no-cache-dir -e ".[test]"

# Copy source
COPY src/ src/
COPY ui/ ui/
COPY database/ database/

# Environment
ENV DCC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_center_commander
ENV PYTHONPATH=/app/src

EXPOSE 8790

CMD ["uvicorn", "dcc.api_async:app", "--host", "127.0.0.1", "--port", "8790"]
