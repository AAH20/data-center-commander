# Data Center Commander — Sentinel governance policy
#
# Enforces the project's non-negotiable infrastructure contracts at plan time.
# Every rule maps to a documented product contract so an operator can cite it.
#
# NOTE ON SCOPE. Sentinel is HashiCorp-proprietary: the *runtime* is free (the CLI
# downloads from releases.hashicorp.com), but *enforcement* — gating a real run —
# exists only inside HCP Terraform and Terraform Enterprise paid tiers, and it does
# not run on OpenTofu at all. This policy is therefore authored and unit-tested
# here, and its rules are mirrored in policies/rego/ where they can actually gate
# this repo's OpenTofu pipeline. Keep the two in step.
#
# This file previously did not parse: it used `all X else [] as y {`, which is not
# Sentinel syntax. The default clause belongs after the block.

import "tfplan/v2" as tfplan

# ---------------------------------------------------------------------------
# Mandatory accountability tags
# ---------------------------------------------------------------------------

mandatory_tags = ["owner", "Environment", "team"]

# `change.after` is the correct field. This previously read `resource.applied.tags`,
# which is not part of tfplan/v2's resource change shape -- so the function returned
# {} for every resource and the rule reported untagged resources that were in fact
# tagged. The Sentinel test harness caught it; nothing else would have.
#
# `else {}` keeps an untagged resource in scope, so the rule reports it rather than
# silently passing a resource that declares no tags at all.
resource_tags = func(resource) {
	return resource.after.tags else {}
}

tagged_resources = filter tfplan.resource_changes as _, rc {
	rc.change.actions contains "create"
}

deny_missing_tags = rule {
	all tagged_resources as _, rc {
		all mandatory_tags as tag {
			tag in keys(resource_tags(rc.change))
		}
	}
}

# ---------------------------------------------------------------------------
# Encryption at rest
# ---------------------------------------------------------------------------

encryption_attributes = {
	"aws_db_instance": "storage_encrypted",
	"aws_ebs_volume":  "encrypted",
}

encryptable_resources = filter tfplan.resource_changes as _, rc {
	rc.type in keys(encryption_attributes) and
		rc.change.actions contains "create"
}

deny_unencrypted_storage = rule {
	all encryptable_resources as _, rc {
		rc.change.after[encryption_attributes[rc.type]] is true
	}
}

# ---------------------------------------------------------------------------
# No public administrative ingress
# ---------------------------------------------------------------------------

admin_ports = [22, 3389]

security_group_rules = filter tfplan.resource_changes as _, rc {
	rc.type is "aws_security_group" and rc.change.actions contains "create"
}

deny_public_admin_ingress = rule {
	all security_group_rules as _, rc {
		all rc.change.after.ingress as ingress {
			not (ingress.cidr_blocks contains "0.0.0.0/0" and (ingress.from_port in admin_ports or ingress.to_port in admin_ports))
		}
	}
}

# ---------------------------------------------------------------------------
# Retention floor for stateful services
# ---------------------------------------------------------------------------

retention_floor = 7

stateful_resources = filter tfplan.resource_changes as _, rc {
	rc.type is "aws_db_instance" and rc.change.actions contains "create"
}

deny_short_backup_retention = rule {
	all stateful_resources as _, rc {
		rc.change.after.backup_retention_period >= retention_floor
	}
}

# ---------------------------------------------------------------------------
# Aggregate gates
# ---------------------------------------------------------------------------

main = rule {
	deny_missing_tags and
	deny_unencrypted_storage and
	deny_public_admin_ingress and
	deny_short_backup_retention
}
