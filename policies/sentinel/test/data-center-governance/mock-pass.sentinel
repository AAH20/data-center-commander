# Mock of the tfplan/v2 import. Supplies the shape the policy reads:
# resource_changes[].type / change.actions / change.after.
#
# Tag vocabulary matches infra/aws-gpu-h200/versions.tf default_tags: Project,
# Environment, CostCenter. Changing the policy's mandatory_tags without changing
# these mocks makes the pass case fail for a reason that looks like a policy bug.
resource_changes = {
	"aws_instance.example": {
		"type": "aws_instance",
		"change": {
			"actions": ["create"],
			"after": {
				"tags": {"Project": "data-center-commander", "Environment": "prod", "CostCenter": "agentic-ai-platform"},
			},
		},
	},
	"aws_db_instance.example": {
		"type": "aws_db_instance",
		"change": {
			"actions": ["create"],
			"after": {
				"tags": {"Project": "data-center-commander", "Environment": "prod", "CostCenter": "agentic-ai-platform"},
				"storage_encrypted": true,
				"backup_retention_period": 14,
			},
		},
	},
	"aws_security_group.example": {
		"type": "aws_security_group",
		"change": {
			"actions": ["create"],
			"after": {
				"tags": {"Project": "data-center-commander", "Environment": "prod", "CostCenter": "agentic-ai-platform"},
				"ingress": [
					{
						"cidr_blocks": ["10.0.0.0/16"],
						"from_port": 22,
						"to_port": 22,
					},
				],
			},
		},
	},
}
