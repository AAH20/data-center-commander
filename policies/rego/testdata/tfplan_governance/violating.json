{
  "format_version": "1.2",
  "terraform_version": "1.6.6",
  "configuration": {
    "provider_config": {
      "aws": {
        "name": "aws",
        "expressions": {
          "default_tags": {
            "tags": {
              "Project": {
                "constant_value": "data-center-commander"
              }
            }
          }
        }
      }
    }
  },
  "resource_changes": [
    {
      "address": "aws_instance.bad",
      "type": "aws_instance",
      "change": {
        "actions": [
          "create"
        ],
        "after": {}
      }
    },
    {
      "address": "aws_db_instance.bad",
      "type": "aws_db_instance",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "storage_encrypted": false,
          "backup_retention_period": 3
        }
      }
    },
    {
      "address": "aws_security_group.bad",
      "type": "aws_security_group",
      "change": {
        "actions": [
          "create"
        ],
        "after": {
          "ingress": [
            {
              "cidr_blocks": [
                "0.0.0.0/0"
              ],
              "from_port": 22,
              "to_port": 22
            }
          ]
        }
      }
    }
  ]
}
