# =============================================================================
# Data Center Commander — SOC Environment Configuration
# =============================================================================

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# Autoscaler
AUTOSCALER_INTERVAL=30
AUTOSCALER_MIN_REPLICAS=2
AUTOSCALER_MAX_REPLICAS=10
AUTOSCALER_CPU_THRESHOLD=75
AUTOSCALER_MEMORY_THRESHOLD=80

# Alertmanager
SMTP_HOST=localhost:587
SMTP_FROM=alerts@datacenter.local
SMTP_USER=
SMTP_PASS=
SLACK_WEBHOOK_URL=
PAGERDUTY_URL=https://events.pagerduty.com/v2/enqueue
PAGERDUTY_KEY=

# Trivy
TRIVY_CACHE_DIR=/data/trivy-cache

# Falco
FALCO_RULES_PATH=/app/soc-tools/falco-rules.yaml
