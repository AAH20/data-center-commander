# Log processor for the IaC logging stack.
#
# Reads from Elasticsearch and Loki, enriches records, and forwards to both.
# The application lives in logging/iac/scripts/log_processor.py.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN pip install --no-cache-dir \
    requests \
    elasticsearch>=8,<9

COPY logging/iac/scripts/log_processor.py /app/log_processor.py

# Non-root: the stack runs unprivileged in the data-center-commander namespace.
RUN useradd --create-home --uid 10001 logproc \
    && chown -R logproc:logproc /app
USER logproc

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

ENTRYPOINT ["python", "/app/log_processor.py"]
