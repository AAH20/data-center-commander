# DCC Application Configuration
# Non-sensitive configuration for Docker Swarm deployment.
# Sensitive values (DCC_DATABASE_URL) are injected via Docker secrets.

DCC_LOG_LEVEL=INFO
DCC_PORT=8790
DCC_HOST=0.0.0.0
DCC_DEMO_MODE=false
DCC_READ_ONLY=true
DCC_TRACING_ENABLED=false
DCC_OTLP_ENDPOINT=http://otel-collector:4317
DCC_SERVICE_NAME=data-center-commander
DCC_TRACE_SAMPLE_RATE=1.0
