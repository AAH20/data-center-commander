# Data Center Commander - IaC Monitoring Stack
# Copy to .env and fill in your values

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ROOT_URL=http://localhost:3000

# Alertmanager - SMTP
SMTP_HOST=localhost:587
SMTP_FROM=alerts@datacenter.local
SMTP_USER=
SMTP_PASS=

# Alertmanager - Slack
SLACK_WEBHOOK_URL=

# Alertmanager - PagerDuty
PAGERDUTY_KEY=
PAGERDUTY_URL=https://events.pagerduty.com/v2/enqueue

# Alertmanager - Webhooks
WEBHOOK_URL=http://localhost:5001/
CRITICAL_WEBHOOK_URL=http://localhost:5001/critical
SECURITY_WEBHOOK_URL=http://localhost:5001/security
