# SOC Monitoring Environment Configuration
# Copy to .env and fill in your values

# SMTP Configuration
SMTP_HOST=localhost:587
SMTP_FROM=soc-alerts@datacenter.local
SMTP_USER=
SMTP_PASS=

# Slack Integration
SLACK_WEBHOOK_URL=

# PagerDuty Integration
PAGERDUTY_KEY=
PAGERDUTY_URL=https://events.pagerduty.com/v2/enqueue

# Webhook Endpoints
WEBHOOK_URL=http://localhost:5001/
SECURITY_WEBHOOK_URL=http://localhost:5001/security
CRITICAL_WEBHOOK_URL=http://localhost:5001/critical

# Grafana Admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
