# Data Center Commander — Distributed Tracing Environment Variables
#
# Copy this file to .env and adjust values as needed.
# Load with: source .env  (or use your preferred env management tool)

# ── Tracing ──────────────────────────────────────────────────────────────────
DCC_TRACING_ENABLED=true
DCC_OTLP_ENDPOINT=http://localhost:4317
DCC_JAEGER_ENDPOINT=http://localhost:14250
DCC_SERVICE_NAME=data-center-commander
DCC_TRACE_SAMPLE_RATE=1.0
DCC_DEPLOYMENT_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DCC_DATABASE_URL=postgresql://dcc:dcc_dev_password@localhost:5432/data_center_commander
