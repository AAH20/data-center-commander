# =============================================================================
# Data Center Commander — Load Balancer IaC Example Variables
# =============================================================================
# Copy this file to `terraform.tfvars` and fill in your values.
# NEVER commit `terraform.tfvars` to version control.
# =============================================================================

project_name = "datacenter-commander"
environment  = "dev"
aws_region   = "us-east-1"

vpc_cidr          = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

instance_type     = "t3.medium"
desired_capacity  = 2
min_size          = 2
max_size          = 6

# Choose "nginx" or "traefik"
load_balancer_type = "nginx"

# ACM certificate ARN for HTTPS (required for production)
acm_certificate_arn = ""

# Enable session stickiness
enable_stickiness = false

common_tags = {
  Project     = "data-center-commander"
  Environment = "dev"
  ManagedBy   = "terraform"
  Owner       = "platform-team"
  CostCenter  = "dc-001"
}
